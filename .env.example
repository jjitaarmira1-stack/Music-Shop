
#  PLANTILLA DE VARIABLES DE ENTORNO
#  Copia este archivo a «.env» y rellena los valores reales:
#      cp .env.example .env
#  El archivo «.env» está en .gitignore y NUNCA debe subirse a git.
# ═══════════════════════════════════════════════════════════════

# ─── OBLIGATORIA · Conexión a PostgreSQL ───────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE_DE_DATOS
# En producción añade «?sslmode=require» si tu proveedor usa TLS.
#
# En Netlify o Vercel NO se pone aquí: este archivo es sólo una
# plantilla. Se define en el panel del sitio, en «Environment
# variables». Ninguna de esas plataformas incluye base de datos, así
# que necesitas una externa (Neon, Supabase, Railway…).
DATABASE_URL=postgresql://usuario:contrasena@127.0.0.1:5432/musicshop

# ─── OBLIGATORIA · Clave de firma de las sesiones ──────────────
# Mínimo 32 caracteres. Si cambia, todas las sesiones se invalidan.
# Genera una aleatoria con:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   La aplicación NO ARRANCA en producción sin esta variable.
SESSION_SECRET=genera-una-clave-aleatoria-de-al-menos-32-caracteres

# ─── OPCIONAL · Entorno de ejecución ───────────────────────────
# Valores admitidos: development | staging | production
# Controla el detalle de los errores y de los registros.
APP_ENV=development

# ─── OPCIONAL · Carpeta de imágenes subidas ────────────────────
# Ruta en disco donde se guardan las fotos que sube el administrador.
# Se mantiene FUERA de «public/» a propósito: así el contenido subido
# por un usuario nunca se sirve como archivo estático ejecutable.
# Por defecto: «<raíz del proyecto>/var/uploads»
#
# ⚠️ En Netlify y Vercel el disco es EFÍMERO: lo que se sube se pierde
# al poco tiempo. No es un fallo del código, es cómo funcionan esas
# plataformas. Si necesitas subir imágenes de forma permanente, usa un
# servicio de objetos (Cloudinary, S3, Supabase Storage) o despliega en
# un servidor con disco real (VPS, Railway, Render).
# Las imágenes del catálogo que trae el proyecto sí funcionan siempre.
UPLOADS_DIR=

# ─── OPCIONAL · Catálogo de demostración ───────────────────────
# «true» inserta los instrumentos de ejemplo si el catálogo está
# vacío. Ponlo en «false» en producción para empezar con la tienda
# limpia y añadir tus propios instrumentos desde el panel.
#
# La cuenta de administración se crea SIEMPRE que no haya ningún
# usuario, valga «true» o «false»: sin ella no podrías entrar.
SEED_DEMO_DATA=true

# ─── RECOMENDADAS EN PRODUCCIÓN · Administrador inicial ────────
# Sólo se usan la PRIMERA vez, cuando no hay ningún usuario todavía.
# Si no las defines, se genera una contraseña aleatoria que se muestra
# una única vez por la consola del servidor.
#
# En Netlify o Vercel conviene DEFINIRLAS: allí la consola es el
# registro de funciones, incómodo de consultar y que además se rota,
# así que es fácil perderse el mensaje y quedarte fuera del panel.
# Una vez creada la cuenta puedes borrar estas dos variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── OPCIONAL · Límite de peticiones (protección fuerza bruta) ─
# Intentos de inicio de sesión permitidos por ventana de tiempo.
RATE_LIMIT_LOGIN_MAX=5
# Duración de la ventana en segundos.
RATE_LIMIT_LOGIN_WINDOW=900

# ─── OPCIONAL · Tamaño del pool de conexiones a PostgreSQL ─────
# Número máximo de conexiones simultáneas que abrirá esta instancia.
# Cuidado al escalar: pool × número de instancias no debe superar el
# «max_connections» del servidor de base de datos.
DB_POOL_MAX=10
